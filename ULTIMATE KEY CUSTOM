--              UTILITIES
-- ══════════════════════════════════════
local function getTime()    return os.time() end
local function formatLeft(s)
    return string.format("%02d:%02d:%02d",
        math.floor(s/3600), math.floor((s%3600)/60), s%60)
end

local function validKey(k)
    if type(k) ~= "string" then return false end
    return k:upper():gsub("%s",""):match(
        "^WNR%-%d%d%d%d%-%u%u%u%-%w%w%w%w%w%w$") ~= nil
end

local function saveKey(k, t)
    if writefile then writefile(SAVE_FILE, k.."|"..tostring(t)) end
end

local function loadKey()
    if isfile and readfile and isfile(SAVE_FILE) then
        local ok, d = pcall(readfile, SAVE_FILE)
        if ok and d then
            local k, t = d:match("^(.+)|(%d+)$")
            if k and t then return k, tonumber(t) end
        end
    end
    return nil, nil
end

local function delKey()
    if isfile and delfile and isfile(SAVE_FILE) then
        pcall(delfile, SAVE_FILE)
    end
end

-- Instance helpers
local function NI(cls, props)
    local o = Instance.new(cls)
    for k, v in pairs(props) do o[k] = v end
    return o
end
local function NL(parent, props)
    local l = NI("TextLabel", {BackgroundTransparency=1, Parent=parent})
    for k, v in pairs(props) do l[k] = v end
    return l
end
local function NB(parent, props)
    local b = NI("TextButton", {BorderSizePixel=0, Parent=parent})
    for k, v in pairs(props) do b[k] = v end
    return b
end
local function NS(parent, col, thick)
    return NI("UIStroke", {Color=col, Thickness=thick or 1.5, Parent=parent})
end
local function NR(parent, radius)
    return NI("UICorner", {CornerRadius=UDim.new(0, radius or 12), Parent=parent})
end
local function NGrad(parent, c1, c2, rot)
    return NI("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rot or 90,
        Parent = parent,
    })
end

