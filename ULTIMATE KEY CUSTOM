--         TEMPLATE FEATURE STATE
-- ══════════════════════════════════════
local State = {
    infiniteJump = false,
    noclip       = false,
    fly          = false,
    speed        = 16,
    jumpPower    = 50,
    flySpeed     = 40,
}

local connections = {}

local function clearConn(key)
    if connections[key] then
        connections[key]:Disconnect()
        connections[key] = nil
    end
end

local function getChar() return LocalPlayer.Character end
local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getHRP()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- Infinite Jump
local function setInfiniteJump(on)
    State.infiniteJump = on
    clearConn("ij")
    if on then
        connections.ij = UIS.JumpRequest:Connect(function()
            local h = getHum()
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    end
end

-- Walk Speed
local function setSpeed(val)
    State.speed = val
    local h = getHum()
    if h then h.WalkSpeed = val end
end

-- Jump Power
local function setJumpPower(val)
    State.jumpPower = val
    local h = getHum()
    if h then h.JumpPower = val end
end

-- Noclip
local function setNoclip(on)
    State.noclip = on
    clearConn("nc")
    if on then
        connections.nc = RunService.Stepped:Connect(function()
            local c = getChar()
            if c then
                for _, v in pairs(c:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
    end
end

-- Fly
local flyBV = nil
local function setFly(on)
    State.fly = on
    clearConn("fly")
    if flyBV then flyBV:Destroy(); flyBV = nil end

    if on then
        local hrp = getHRP()
        local hum = getHum()
        if not hrp or not hum then State.fly = false; return end
        hum.PlatformStand = true
        flyBV = NI("BodyVelocity", {
            Velocity  = Vector3.zero,
            MaxForce  = Vector3.new(1e5, 1e5, 1e5),
            P         = 1e4,
            Parent    = hrp,
        })
        connections.fly = RunService.Heartbeat:Connect(function()
            if not State.fly or not flyBV then return end
            local hrp2 = getHRP()
            if not hrp2 then return end
            local d = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then d = d + Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then d = d - Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then d = d - Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then d = d + Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d = d - Vector3.new(0,1,0) end
            if UIS.TouchEnabled and d == Vector3.zero then
                d = Camera.CFrame.LookVector
            end
            flyBV.Velocity = d.Magnitude > 0 and d.Unit * State.flySpeed or Vector3.zero
        end)
    else
        local h = getHum()
        if h then h.PlatformStand = false end
    end
end

-- Re-apply on respawn
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if State.infiniteJump then setInfiniteJump(true) end
    if State.speed ~= 16   then setSpeed(State.speed) end
    if State.jumpPower ~= 50 then setJumpPower(State.jumpPower) end
    if State.noclip        then setNoclip(true) end
    if State.fly           then setFly(true) end
end)

