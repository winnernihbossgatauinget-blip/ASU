            TextXAlignment=Enum.TextXAlignment.Right, ZIndex=12,
        })

        -- Slider track
        local Track = NI("Frame", {
            Size=UDim2.new(1,-20,0,6),
            Position=UDim2.new(0,10,0,34),
            BackgroundColor3=C.border,
            BorderSizePixel=0, ZIndex=12, Parent=f,
        })
        NR(Track, 6)
        local t = (initV - minV) / (maxV - minV)
        local Fill = NI("Frame", {
            Size=UDim2.new(t,0,1,0),
            BackgroundColor3=C.orange,
            BorderSizePixel=0, ZIndex=13, Parent=Track,
        })
        NR(Fill, 6)
        NGrad(Fill, C.blue, C.orange, 90)
        local Knob2 = NI("Frame", {
            Size=UDim2.new(0,16,0,16),
            AnchorPoint=Vector2.new(0.5,0.5),
            Position=UDim2.new(t,0,0.5,0),
            BackgroundColor3=C.white,
            BorderSizePixel=0, ZIndex=14, Parent=Track,
        })
        NR(Knob2, 50)
        NI("UIStroke", {Color=C.orange, Thickness=2, Parent=Knob2})

        -- Drag
        local dragging = false
        local function updateSlider(x)
            local abs = Track.AbsolutePosition.X
            local w   = Track.AbsoluteSize.X
            local pct = math.clamp((x - abs) / w, 0, 1)
            local val = math.floor(minV + pct * (maxV - minV))
            Fill.Size = UDim2.new(pct, 0, 1, 0)
            Knob2.Position = UDim2.new(pct, 0, 0.5, 0)
            ValLbl.Text = tostring(val)
            callback(val)
        end

        Knob2.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if dragging then
                if i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch then
                    updateSlider(i.Position.X)
                end
            end
        end)
        Track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                updateSlider(i.Position.X)
                dragging = true
            end
        end)
        return f
    end

    -- ── BUILD MENU ROWS ──
    SectionLabel("🏃", "MOVEMENT")
    ToggleRow("🦘", "Infinite Jump",  false, function(on) setInfiniteJump(on) end)
    SliderRow("👟", "Walk Speed",     1, 200, 16, function(v) setSpeed(v) end)
    SliderRow("🚀", "Jump Power",     1, 300, 50, function(v) setJumpPower(v) end)

    SectionLabel("✨", "SPECIAL")
    ToggleRow("👻", "Noclip",         false, function(on) setNoclip(on) end)
    ToggleRow("🦅", "Fly",            false, function(on) setFly(on) end)
    SliderRow("💨", "Fly Speed",      10, 200, 40, function(v) State.flySpeed = v end)

    -- Mobile fly note
    rowCount = rowCount + 1
    local Note = NI("Frame", {
        Size=UDim2.new(1,0,0,28),
        BackgroundColor3=Color3.fromRGB(15,30,55),
        BorderSizePixel=0, LayoutOrder=rowCount, Parent=Content,
    })
    NR(Note, 8)
    NL(Note, {
        Size=UDim2.new(1,-10,1,0), Position=UDim2.new(0,8,0,0),
        Text="📱 Mobile Fly: camera direction = forward, Space=up",
        TextColor3=C.dim, Font=Enum.Font.Gotham, TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true,
    })

    -- Compute panel height
    local PANEL_H = 50 + (rowCount * 44) + 20
    Panel.Size = UDim2.new(0,280,0,PANEL_H)
    Content.Size = UDim2.new(1,-16,0, rowCount * 44)

    -- Toggle panel visibility
    local visible = true
    TogBtn.MouseButton1Click:Connect(function()
        visible = not visible
        TweenService:Create(Panel, TweenInfo.new(0.25, Enum.EasingStyle.Quad),
            {Size=UDim2.new(0,280,0, visible and PANEL_H or 0)}):Play()
        Panel.Visible = true
        TogBtn.Text = visible and "🗝️ WNR" or "🗝️ Menu"
    end)

    -- Drag panel
    local dragPanel, dragStart, dragStartPos = false
    PHdr.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragPanel = true
            dragStart = i.Position
            dragStartPos = Panel.Position
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragPanel = false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragPanel and i.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = i.Position - dragStart
            Panel.Position = UDim2.new(
                dragStartPos.X.Scale, dragStartPos.X.Offset + delta.X,
                dragStartPos.Y.Scale, dragStartPos.Y.Offset + delta.Y
            )
        end
    end)

    -- Countdown timer
    local rem = timeLeft
    local timerConn
    timerConn = RunService.Heartbeat:Connect(function(dt)
        rem = rem - dt
        if rem <= 0 then
            timerConn:Disconnect()
            SG:Destroy()
            delKey()
            warn("[WNR] ⏰ Key expired! Please re-run the script.")
            return
        end
        TimerLbl.Text = "⏱️ " .. formatLeft(math.floor(rem))
    end)

    return SG
end

