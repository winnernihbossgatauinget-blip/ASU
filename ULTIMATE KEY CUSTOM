local function onVerified(key)
    local now = getTime()
    saveKey(key, now)
    createMainMenu(key, KEY_DUR)
    print("[WNR] 🎉 Key verified: " .. key)
    print("[WNR] 🎮 Script loaded! Features ready.")

    -- !! PUT YOUR MAIN SCRIPT HERE !!
    -- loadstring(game:HttpGet("https://your-script.com/script.lua"))()
end

local function start()
    -- Check saved key
    local sk, st = loadKey()
    if sk and st then
        local rem = KEY_DUR - (getTime() - st)
        if rem > 0 then
            print("[WNR] ✅ Saved key valid. Remaining: " .. formatLeft(math.floor(rem)))
            createMainMenu(sk, rem)
            onVerified(sk)
            return
        else
            print("[WNR] ⏰ Key expired. Please enter a new key.")
            delKey()
        end
    end

    -- Show key input UI
    local ui = createKeyUI()

    local function doVerify()
        local k = ui.InputBox.Text:upper():gsub("%s", "")
        if not validKey(k) then
            ui.StatusLbl.Text = "❌ Wrong format! Example: WNR-4821-KZM-A3BF9X"
            TweenService:Create(ui.IS, TweenInfo.new(0.15), {Color=C.red}):Play()
            task.delay(2.5, function()
                ui.StatusLbl.Text = ""
                TweenService:Create(ui.IS, TweenInfo.new(0.2), {Color=C.orange}):Play()
            end)
            return
        end
        ui.VerBtn.Text = "⏳ Verifying..."
        ui.VerBtn.BackgroundColor3 = C.yellow
        task.delay(1, function()
            ui.SG:Destroy()
            onVerified(k)
        end)
    end

    ui.VerBtn.MouseButton1Click:Connect(doVerify)
    ui.InputBox.FocusLost:Connect(function(entered)
        if entered then doVerify() end
    end)
end

